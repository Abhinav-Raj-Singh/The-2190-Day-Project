#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n ; 
    cin >> n; 
    int p = n;
    int r_n = 0;
    int digits = 0 ;
    vector <int> b (10);

    for(int i = 1 ; i < 10 ; i++){
        if(n <= 9 && n > 0){
            r_n++;
            digits++;
            b.insert(b.begin()+i , n*round(pow(10,digits-1)));
            n = 0 ;
            break;
        }

        else if(n > 9 && n%10 != 0){
            r_n++;
            digits++;

            b.insert(b.begin()+i , (n%10)*round(pow(10,digits-1)) );
            n= n/10;
        }
        
        else if(n%10 == 0){
            digits++;

            n = n/10;
            

        }
    }
    cout << r_n << '\n';
    
    erase(b,0);
    // cout << b[1] << '\n';
    int j = 0;
    for(int i = b.size()-1 ; i >= 0 ; i--){
        cout << b[i] << ' ' ;
        j++;
    }
    cout << '\n';

}


int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;

    while(t--){
    solve();
    }


    return 0;
}
