#include <bits/stdc++.h>
using namespace std;

void solve(){
    long long n ;
    int k ;
    cin >> n >> k;
    

    
    for(int i = 0 ; i < k ; i++){
        if(n % 10 == 0){
           n = n/10;
        }
        else if(n % 10 != 0){
            n = n-1;
        }
    }
    cout << n << '\n' ;
}

int main(){
    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();

    return 0;
}
