#include <bits/stdc++.h>
using namespace std;

void solve(){
    string s;
    cin >> s;
    int lower_count = 0;
    int upper_count = 0;
    for(int i = 0 ; i < s.size(); i++){
        if(s[i] == toupper(s[i])){
            upper_count++;
        }
        else if(s[i] == tolower(s[i])){
            lower_count++;
        }
    }
    if(upper_count <= lower_count){
        for(int i = 0 ; i < s.size() ; i++){
            cout << static_cast<char>(tolower(s[i])) ;
        }
        cout << '\n';
    }
    else if(upper_count > lower_count){
        for(int i = 0 ; i < s.size() ; i++){
            cout << static_cast<char>(toupper(s[i])) ;
        }
        cout << '\n';
    }

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();

    return 0;

}
