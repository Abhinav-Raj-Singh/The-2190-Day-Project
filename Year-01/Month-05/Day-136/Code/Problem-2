#include <bits/stdc++.h>
using namespace std;

void solve(){
    int year = 0 ;
    
    int a , b;
    cin >> a >> b;
    int total = a+b;
    if(a == b){
        year = 1;

    }
    else{
    for(int i = 0 ; i < (total) ; i++){
       
        if(a < b){
            a = 3*a;
            b = 2*b;
            year = year + 1; 
            
        }
        else if(a == b){
            year = year + 1;
            break;
        }
        if(a > b){
          
            break;
        }
    }

}
    cout << year << '\n';

}

int main(){
ios_base::sync_with_stdio(0);cin.tie(0);
solve();

    return 0;
}
