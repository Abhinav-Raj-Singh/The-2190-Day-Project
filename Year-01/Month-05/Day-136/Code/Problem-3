#include <bits/stdc++.h>
using namespace std;


void solve(){
    int x; 
    cin >> x;
    int step_count = 0;
    int remaining_dist = x;
    for(int i = 0 ; i < x;  i++){
        if(remaining_dist >= 5){
            remaining_dist = remaining_dist - 5;
            step_count = step_count + 1;
        }
        else if(remaining_dist < 5){
            remaining_dist = 0 ;
            step_count = step_count + 1;
        }
        if(remaining_dist == 0){
            break;
        }
    }
    cout << step_count << '\n';
}

int main(){
    solve();


    return 0;
}
