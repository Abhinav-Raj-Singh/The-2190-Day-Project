#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n , h;
    cin >> n >> h;
    vector <int> a1 (n,0);
    int road_w = 0;
    
    for(int i = 0 ; i < n ; i++){
        cin >> a1[i];
    }
    for(int i = 0 ; i < n; i++){
        if(a1[i] <= h){
            road_w++;
        }
        else if(a1[i] > h){
            road_w += 2;
        }
    }
    cout << road_w << '\n';

    

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    
    solve();

    return 0;
}
