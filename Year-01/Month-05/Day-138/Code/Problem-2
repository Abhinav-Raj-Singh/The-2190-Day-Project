#include <bits/stdc++.h>
using namespace std;


void solve(){

    string s,t;
    cin >> s >> t;
    int j = 1;
    string check = "NO";
    if(t.size() > s.size()){
        check = "NO";
    }
    
    else if(t.size() <= s.size()){
    for(int i = 0 ; i < s.size() ; i++){
        if(t[i] == s[s.size() - j]){
            check = "YES";
            j++;
        }
        else if(t[i] != s[s.size() - 1]){
            check = "NO";
            break;
        }
    }
    }
    cout << check << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);

    solve();

    return 0;
}
