#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define out std::cout 
#define in std::cin 
#define loop for(int i = 0 ; i < n ; i++)

void solve(){
    ll n , h;
    in >> n >> h;
    ll x ;
    ll answer;
    answer = n;

    loop{
        in >> x;
        
        answer += (x > h);
    }
    out << answer << '\n';

    

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    
    solve();

    return 0;
}
