// Time complexity that doesn't seem to be n^2

    int n ; 
    cin >> n; 
    int ct = 0;
    for(int i = 0 ; i <= n ; i++){
        for(int j = 0 ; j <= i ; j++){
            ct++;
        }
    }
    // n < 1e5
    // 'O' = O(1) + O(1) + O(1) + O(ct) , O(ct) = 0 + 1 + 2... sum upto n = number of iterations of ct = O(n^2/2) + O(n/5)
    // 'O' = O(ct) = O(n^2)

/*
Give T testcases and an array of size N . print sum of array of size N in each test case

1 <= T <= 1000
1 <= N <= 1000
1 <= a[i] <= 1000
*/

    int sum = 0;
    int t ; 
    cin >> t;
    while(t--){
        int n ;
        cin >> n ; 
        sum = 0; 
        for(int i = 0 ; i < n ; i++){
            int x; 
            cin >> x; 
            sum = sum + x;
        }
    }
        cout << sum << endl; 

// 'O' :- O(T*N) = O(N^2) , because they are similar and we always give time complexity in one variable in higher one

}
