#include <bits/stdc++.h>
using namespace std;

void solve(){

    int n ; 
    cin >> n; 
    int a,b;
    set <int> sitting ;
    int total = 0;
    
    for(int i = 0 ; i < n ; i++){
        cin >> a >> b;
        total = (total - a) + b;
        sitting.insert(total);

    }
   
    cout << (*sitting.rbegin()) << '\n';
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);

    solve();

    return 0;
}
