#include <bits/stdc++.h>
using namespace std;

int main()
{

    string s;
    cin >> s;
    int a{0};
    int l{0};
    bool check = false;

    for (int i = 0; i < s.size(); i++)
    {
        if (s[i] == 'A')
        {
            ++a;
            if (l > 0 && l < 3)
            {
                l = 0;
            }
        }
        else if (s[i] == 'L')
        {
            ++l;
        }
        else if (s[i] == 'P')
        {
            if (l > 0 && l < 3)
            {
                l = 0;
            }
        }
    }

    if (a < 2 && l < 3)
    {
        check = true;
    }
    else
    {
        check = false;
    }

    cout << boolalpha << check << endl;
}
