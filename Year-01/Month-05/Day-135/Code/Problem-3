#include <bits/stdc++.h>
using namespace std;

    int check = 0 ;

void solve(){

    string a,b;
    cin >> a >> b;
    for(int i = 0 ; i < a.size() ; i++){
        
            if(tolower(a[i]) == tolower(b[i])){
                check = 0;
                
            }
            else if(tolower(a[i]) > tolower(b[i])){
                check = 1;
                break;
            }
            else if(tolower(a[i]) < tolower(b[i])){
                check = -1;
                break;
            
        }
    }


}    

int main(){

    ios::sync_with_stdio(0);cin.tie(0);
    solve();
    cout << check << "\n";
    return 0;
}
