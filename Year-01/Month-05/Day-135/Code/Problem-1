#include <bits/stdc++.h>
using namespace std;

   
void solve(){

    string a;
    cin >> a; 
   
    set <char> unique_char;
    for(int i = 0 ; i < a.size() ; i++){
        unique_char.insert(a[i]);
        
    }
    if(unique_char.size() % 2 == 0 ){
        cout << "CHAT WITH HER!" << "\n";
    }
    else if(unique_char.size() % 2 != 0 ){
        cout << "IGNORE HIM!" << "\n";
    }

}

int main(){

ios::sync_with_stdio(0);cin.tie(0);
    solve();
   
    return 0;
}
