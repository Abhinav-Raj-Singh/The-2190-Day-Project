#include <bits/stdc++.h>
using namespace std;



int main(){

    constexpr auto myarray1 {to_array <int , 5> ({1,2,3,4,5})}; // specify type and size.
    constexpr auto myarray2 {to_array <int> ({1,3,5,7,5})}; // Will deduce size automatically.
    constexpr auto myarray3 {to_array ({1,3,56,6})}; // Deduce type and size .

    // int a = 5L; // Give 4 
    // cout << sizeof(5L) << '\n'; // Give 8
    // cout << sizeof(5S) << '\n'; // Give Error
    constexpr auto Shortarray {to_array <short> ({1,3,5})} ;
    cout << sizeof(Shortarray[0]) << '\n';

    // Define a std::array that will hold the high temperature for each day of the year (to the nearest tenth of a degree).

    array <double,5> high_temp{};

    // Initialize a std::array with the following values: ‘h’, ‘e’, ‘l’, ‘l’, ‘o’. Print the value of the element with index 1.
    array <char, 5> greet {'h','e','l','l','o'};// Valid
    // array greet {'h','e','l','l','o'};  // Valid
    cout << greet[1] << '\n';
    cout << greet.empty() << '\n';
    cout << greet.size() << '\n'; 

    return 0;
}
