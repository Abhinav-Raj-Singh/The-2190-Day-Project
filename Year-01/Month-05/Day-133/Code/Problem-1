#include <bits/stdc++.h>
using namespace std;

    int j = 0; 

void solve(){
    string s;
    cin >> s;
    
    if(s == "++x" || s == "++X" || s == "x++" || s == "X++"){
        j++;
    }
    else if(s == "--x" || s == "--X" || s == "x--" || s == "X--"){
        j--;
    }


}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int n ; 
    cin >> n ; 
    while(n--){
        solve();
    }
    cout << j << "\n";
}
