#include <bits/stdc++.h>
using namespace std;
int n,k;
int j = 0;
vector <int> a;


void solve(){
a.resize(n);
for(int i = 0 ; i < n ; i++){
    cin >> a[i];
}
int r = a[k-1];

for(int i = 0 ; i < n ; i++){
    if(a[i] >= r && a[i]!= 0){
            j++;
        }
}
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    cin >> n >> k;
    solve();
    cout << j << "\n";


}
