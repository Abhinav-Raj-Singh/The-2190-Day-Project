#include <bits/stdc++.h>
using namespace std;


int main(){

    int n , k ;
    int j = 0 ;
    cin >> n >> k;

    vector <int> a(n);

    for(int i = 0 ; i < n ; i++){
        cin >> a[i];
    }

    int r = a[k-1];
    
    for(int i = 0 ; i < n ; i++){
        if(a[i] >= r && a[i]!= 0){
            j++;
        }
    }
    cout << j << "\n";


}
