#include <bits/stdc++.h>
using namespace std;

void solve(){
    int t;
    cin >> t;
    while(t--){
        int a , b , c;
        cin >> a >> b >> c;
        
        if(a+b == c){
            cout << '+' << '\n';
        }
        else{
            cout << '-' << '\n';
        }
}
}



int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();


    return 0;
}
