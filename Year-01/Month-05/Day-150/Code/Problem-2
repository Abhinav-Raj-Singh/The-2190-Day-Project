#include <bits/stdc++.h>
using namespace std;

void solve(){
    string n;
    getline(cin,n);
    for(int i = 0 ; i < n.size() ; i++){
        if(n[i] == '.'){
            cout << '0';
        }
        else if(n[i] == '-' && n[i+1] == '.'){
            cout << '1';
            i++;
        }
        else if(n[i] == '-' && n[i+1] == '-'){
            cout << '2';
            i++;
        }
    }
    cout << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve ();
    return 0;
}
