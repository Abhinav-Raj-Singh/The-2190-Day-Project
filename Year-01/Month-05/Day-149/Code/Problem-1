// Weird algorithm on cses problem set

#include <bits/stdc++.h>
using namespace std;

void solve (){
    long long n ;
    cin >> n;
    if(n == 1){
        cout << n << '\n'; 
    }
    else if(n!= 0){
        for(int i = 0 ; i < 1000; i++){
        if(n % 2 == 0){
            cout << n << ' ';
            n = n / 2;
        }
        else if(n%2 !=0){
            cout << n << ' ' ;
            n  = n * 3;
            n += 1; 
        }
        if(n == 1){
            cout << n << ' ' ;
            break;
        }
        }
    }

}


int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();


    return 0;
}
