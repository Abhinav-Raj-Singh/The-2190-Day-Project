#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n ; 
    cin >> n;
    int group = 1 ; 

    string current , previous;
    
    cin >> previous;
    for (size_t i = 0 ; i < n ; i++){
        if(n ==1){
            group = 1;
            break;
        }
        else {
        cin >> current;

        if(current != previous){
            group++;
        }
        previous = current;
        
    }
    }
    cout << group << '\n';
}


int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();

    return 0;
}
