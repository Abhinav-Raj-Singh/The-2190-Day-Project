#include <bits/stdc++.h>
using namespace std;

void solve(){
    long long a,b;
    cin >> a >> b;
    if(a==b || a%b ==0){
        cout << 0 << '\n';
    }
    else if(a != b){
        cout << (b - (a%b)) << '\n';
    }

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t ; 
    cin >> t;
    while(t--){
    solve();
    }


    return 0;
}
