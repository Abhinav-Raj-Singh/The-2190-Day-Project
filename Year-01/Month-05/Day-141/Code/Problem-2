#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n ,a ; 
    cin >> n;
    double sum = 0 ;
    double result ; 
    for(size_t i = 0 ; i < n ; i++){
        cin >> a;
        sum += a;
    }
    // cout << sum << '\n';
    // cout << n << '\n';
    result = static_cast<double>((sum/n));
    cout << fixed << setprecision(12) ;
    cout << result << '\n';

}


int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();


    return 0;
}
