#include <bits/stdc++.h>
using namespace std;

void solve(){
    string s1,s2;
    cin >> s1 >> s2;
    string s;
    for(size_t i = 0 ; i < s1.size() ; i++){
        if(s1[i] == s2[i]){
            s.append("0");
        }
        else if(s1[i] != s2[i]){
            s.append("1");
        }
        
    }
    cout << s << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);

    solve();

    return 0;
}
