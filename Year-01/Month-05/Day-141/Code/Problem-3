#include <bits/stdc++.h>
using namespace std;


void solve(){
    int n ;
    cin >> n ;
    vector <int> b(n+1);
    int a ;
    for (size_t i = 1 ; i <= n ; i++){
        cin >> a;
        b[a] = i;
    }
    for (size_t i = 1 ; i <= n ; i++){
        cout << b[i] << " " ;
    }
    cout << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);

    solve();


    return 0;
}
