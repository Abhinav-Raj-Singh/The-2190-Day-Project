#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n ; 
    cin >> n ; 
    int p , q;
    int rooms = 0 ;
    for(int i = 0 ; i < n ; i++){
        cin >> p >> q;
        if((q-p)>= 2){
            rooms++;
        }
    }
    cout << rooms << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();

    return 0;
}
