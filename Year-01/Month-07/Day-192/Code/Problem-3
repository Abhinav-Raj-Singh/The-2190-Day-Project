    string last_name;
    int standard;

    // cout << "Enter age: " << '\n';
    cin >> age;
    // cout << "Enter First Name: " << '\n';
    cin >> first_name;
    // cout << "Enter Last Name: " << '\n';
    cin >> last_name;
    // cout << "Enter Standard: " << '\n';
    cin >> standard;
    
