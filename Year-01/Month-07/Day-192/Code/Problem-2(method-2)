// Problem-2(method-2) 
// Codeforces 758/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
   
    int n;
    cin >> n;
    vector <long long> d(n);
    for(int i = 0 ; i < n ; i++){
        cin >> d[i];
    }
    sort(d.begin(),d.end());
    reverse(d.begin(),d.end());
   
    long long ans = 0 ; 
    for(int i = 0 ; i < n ; i++){
        ans += (d[0]-d[i]);
    }
    cout << ans << '\n';


}

