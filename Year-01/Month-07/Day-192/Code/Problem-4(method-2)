// Problem-4(method-2)
// Codeforces 1873/C

#include <bits/stdc++.h>
using namespace std;

void solve(){
   
   
    int ans = 0;
    for(int i = 0 ; i < 10 ; i++){
        for(int j = 0 ; j < 10 ; j++){
            char c;
            cin >> c;
            if(c == 'X'){
                ans += min({i+1,10-i,j+1,10-j});
            }
        }
    }
    cout << ans << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    

    return 0;
}
