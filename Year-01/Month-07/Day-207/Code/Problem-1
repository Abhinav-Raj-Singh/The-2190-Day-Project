// Problem-1
// Codeforces-1851/problem/A

#include <bits/stdc++.h>
using namespace std;
#define fast_io ios_base::sync_with_stdio(0);cin.tie(0);
typedef long long ll;
#define fl(n) for(int i = 0 ; i < n ; i++)
#define vi(v,n) vector <int> v(n);
#define flvi(v,n) for(int i = 0 ; i < n ; i++){cin >> v[i];};
#define flvo(v,n) for(int i = 0 ; i < n ; i++){cout << v[i] << ' ';}; cout << '\n';
#define otn(r) cout << r << '\n'
#define ot(r) cout << r 
#define otc(r) cout << r << ' ' 

void solve(){
    ll n , m , k , h;
    cin >> n >> m >> k >> h;
    vector<int> ppl(n);
    flvi(ppl,n);
    vector<int> stps;
    for(int i = 1 ; i <= m ; i++){
        stps.push_back(k*i);
    }
    ll cnt = 0;
   
    
    for(int i = 0 ; i < n ; i++){
        if(find(stps.begin(),stps.end()-1,abs(ppl[i]-h)) != stps.end()-1){
            cnt++;

        }
    }
    otn(cnt);
}

int main(){

    fast_io;
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}
