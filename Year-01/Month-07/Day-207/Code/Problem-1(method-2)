// Problem-1(method-2)
// Codeforces-1851/problem/A

#include <bits/stdc++.h>
using namespace std;
#define fast_io ios_base::sync_with_stdio(0);cin.tie(0);
typedef long long ll;
#define fl(n) for(int i = 0 ; i < n ; i++)
#define vi(v,n) vector <int> v(n);
#define flvi(v,n) for(int i = 0 ; i < n ; i++){cin >> v[i];};
#define flvo(v,n) for(int i = 0 ; i < n ; i++){cout << v[i] << ' ';}; cout << '\n';
#define otn(r) cout << r << '\n'
#define ot(r) cout << r 
#define otc(r) cout << r << ' ' 

void solve(){
    ll n , m , k , h;
    cin >> n >> m >> k >> h;
    vector<int> ppl(n);
    flvi(ppl,n);
    ll diff = (k*m)-k;
    ll cnt = 0;
   
    for(int i = 0 ; i < n ; i++){
        if(((abs(ppl[i]-h))%k == 0) && h != ppl[i] && abs(ppl[i]-h) <= diff){
            cnt++;
            
        }
    }
    otn(cnt);
}

int main(){

    fast_io;
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}
