// Problem-4
// Codeforces - 219774/problem/E

#include <bits/stdc++.h>
using namespace std;

void solve(){
   int n;
   cin >> n;
   vector <int> d(n);
   int mn = 100000000;
   int mni = 0;
   for(int i = 0 ; i < n ;i++){
        cin >> d[i];
        if(d[i] < mn){
            mn = d[i];
            mni = i;
        }
        
   }
   
   cout << mn << ' ' << (mni+1)<<'\n';
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();
    return 0;
}
