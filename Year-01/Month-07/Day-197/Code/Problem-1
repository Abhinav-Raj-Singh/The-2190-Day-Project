// Codeforces - 219774/problem/B

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    vector <int> d(n);
    for(int i = 0 ; i < n ;i++){
        cin >> d[i];

    }
    int x;
    cin >> x;
    auto it = find(d.begin(),d.end(),x);
    if(it != d.end()){
        cout << distance(d.begin(),it) << '\n'; 
    }
    else{
        cout << -1 << '\n'; 

    }
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();
    return 0;
}
