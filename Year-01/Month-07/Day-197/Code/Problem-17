// Problem-17
// Codeforces - 219158/problem/O

#include <bits/stdc++.h>
using namespace std;

void solve()
{
    int a, b;
    char s;
    cin >> a >> s >> b;
    if (s == '+')
    {
        cout << (a + b) << '\n';
    }
    else if (s == '-')
    {
        cout << (a - b) << '\n';
    }
    else if (s == '/')
    {
        cout << (a / b) << '\n';
    }
    else
    {
        cout << (a *b) << '\n';
    }
}

int main()
{

    ios_base::sync_with_stdio(0);
    cin.tie(0);

    solve();

    return 0;
}
