// Problem-23
// Codeforces - 219856/problem/J

#include <bits/stdc++.h>
using namespace std;

void solve()
{
  string s;
  cin >> s;
  vector <int> d(26,0);
  for(auto &c :s){
    d[c - 'a']++;
  }
  
  for(int i = 0 ; i < 26 ; i++){
    if(d[i] > 0){
        cout << (char)(i+'a') << " : " << d[i] << '\n';
    }
  }
}

int main()
{

    ios_base::sync_with_stdio(0);
    cin.tie(0);
    
    solve();
    

    return 0;
}
