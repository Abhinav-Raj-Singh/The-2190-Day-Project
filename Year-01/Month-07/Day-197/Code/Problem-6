// Codeforces - 219774/problem/F

#include <bits/stdc++.h>
using namespace std;

void solve()
{
    int n;
    cin >> n;
    vector<int> d(n);
    for (int i = 0; i < n; i++)
    {
        cin >> d[i];
    }
    reverse(d.begin(), d.end());
    for (auto &c : d)
    {
        cout << c << ' ';
    }
    cout << '\n';
}

int main()
{

    ios_base::sync_with_stdio(0);
    cin.tie(0);
    solve();
    return 0;
}
