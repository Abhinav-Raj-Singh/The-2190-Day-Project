// Problem-9
// Codeforces - 219774/problem/I

#include <bits/stdc++.h>
using namespace std;

void solve()
{
    int n;
    cin >> n;
    vector<int> d(n);
    for (int i = 0; i < n; i++)
    {
        cin >> d[i];
    }
    vector <int> r;
    for(int i = 0 ; i < n+2 ; i++){
        for(int j = i+1 ; j < n ;j++){
            int c = d[i] + d[j] + (j-i);
            r.push_back(c);
        }
    }
    sort(r.begin(),r.end());
    cout << r[0] << '\n';
    
}

int main()
{

    ios_base::sync_with_stdio(0);
    cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
