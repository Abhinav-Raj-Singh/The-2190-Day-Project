// Codeforces - 1840/problem/A

#include <bits/stdc++.h>
using namespace std;
#define fast_io ios_base::sync_with_stdio(0);cin.tie(0);
typedef long long ll;
#define fl(n) for(int i = 0 ; i < n ; i++)
#define vi(v,n) vector <int> v(n);
#define flvi(v,n) for(int i = 0 ; i < n ; i++){cin >> v[i];};
#define flvo(v,n) for(int i = 0 ; i < n ; i++){cout << v[i] << ' ';}; cout << '\n';
#define otn(r) cout << r << '\n'
#define ot(r) cout << r 
#define otc(r) cout << r << ' ' 

void solve(){
  ll n;
  cin >> n;
  cin.ignore();
  string s;
  getline(cin,s);
  char cur = s[0];
  
  string ans = "";
  for(int i = 1 ; i < n ; i++){
    if(cur == s[i]){
        ans.push_back(cur);
        ll r = i+1;
        cur = s[r];
        i++;
    } 
  }
  otn(ans);
}

int main(){

    fast_io;
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}
