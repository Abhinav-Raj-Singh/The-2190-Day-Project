#include <bits/stdc++.h>
using namespace std;

void solve()
{
    int a, b;
    cin >> a >> b;
    if (a % b == 0 || (b % a) == 0)
    {
        cout << "Multiples" << '\n';
    }
    else
    {
        cout << "No Multiples" << '\n';
    }
}

int main()
{

    ios_base::sync_with_stdio(0);
    cin.tie(0);

    solve();

    return 0;
}
