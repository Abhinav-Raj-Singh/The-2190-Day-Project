#include <bits/stdc++.h>
using namespace std;

void solve(){
    long long a , b;
    cin >> a >>b;
    cout << a << ' ' << "+ " << b << " = " << (a+b) << '\n';
    cout << a << ' ' << "* " << b << " = " << (a*b) << '\n';
    cout << a << ' ' << "- " << b << " = " << (a-b) << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
   
   
    solve();
    
    return 0;
}
