#include <bits/stdc++.h>
using namespace std;

void solve()
{   
    vector <int> d(3);
    vector <int> e(3);
    for(int i = 0 ; i < 3; i++){
        cin >> d[i];
        e[i] = d[i];
    }
    sort(d.begin(),d.end());
    for(auto &c :d){
        cout << c << '\n' ;
    }
    cout << '\n';
   
  

    for(auto &c :e){
        cout << c << '\n' ;
    }
    cout << '\n';

}

int main()
{

    ios_base::sync_with_stdio(0);
    cin.tie(0);

    solve();

    return 0;
}
