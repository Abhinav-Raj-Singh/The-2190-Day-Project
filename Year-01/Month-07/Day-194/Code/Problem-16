// Codeforces 219158/problem/W

#include <bits/stdc++.h>
using namespace std;

void solve()
{   
    long long a,b,c;
    char s,q;
    cin >> a >> s >> b >> q>> c;
    if(s == '+'){
        if((a + b) == c){
            cout << "Yes" << '\n';
        }
        else{
            cout << (a+b) << '\n';

        }
    }
    else if(s == '-'){
        if((a - b) == c){
            cout << "Yes" << '\n';
        }
        else{
            cout << (a-b) << '\n';

        }
    }
    else if(s == '*'){
        if((a * b) == c){
            cout << "Yes" << '\n';
        }
        else{
            cout << (a*b) << '\n';

        }
    }
}

int main()
{

    ios_base::sync_with_stdio(0);
    cin.tie(0);

    solve();

    return 0;
}
