// Problem-2
// Codeforces 598/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    long long n;
    cin >> n;
    int r = log2(n)+1;
    long long value = 0;
    for(int i = 0 ;  i < r ; i++){
        value += (1 << i);
    }
    long long sum = (((n*(n+1))/2)-(2*value));
    
    
    cout << sum << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
