// Problem-1
// Codeforces - 580 A

#include <bits/stdc++.h>
using namespace std;


void solve(){

    long long n;
    cin >> n;
    vector <long long> d(n);
    vector <long long> s;
    for(int i = 0 ; i < n ; i++){
        cin >> d[i];
    }
    long long current = d[0];
    long long len = 1;
    for(int i = 1 ; i <= n-1 ; i++){
        if(current <= d[i]){
            len++;
            current = d[i];
        }
        else{
            s.push_back(len);
            current = d[i];
            len = 1;

        }
    }
    s.push_back(len);
    sort(s.rbegin(),s.rend());
    cout << s[0] << '\n';
}

int main(){
    
    ios_base::sync_with_stdio(0);cin.tie(0);

    solve();

    return 0;
}
