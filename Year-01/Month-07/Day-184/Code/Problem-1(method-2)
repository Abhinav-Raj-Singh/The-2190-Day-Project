// Problem-1(method-2)
// Codeforces - 580 A

#include <bits/stdc++.h>
using namespace std;


void solve(){

    long long n;
    cin >> n;
    vector <long long> d(n);
    for(int i = 0 ; i < n ; i++){
        cin >> d[i];
    }
    long long current = d[0];
    long long len = 1;
    long long current_l = 1;
    for(int i = 1 ; i <= n-1 ; i++){
        if(current <= d[i]){
            current_l++;
            current = d[i];
        }
        else{
           len = max(len , current_l);
            current_l = 1;
            current = d[i];
        }
    }
    len = max(len,current_l);
    // s.push_back(len);
    // sort(s.rbegin(),s.rend());
    cout << len << '\n';
}

int main(){
    
    ios_base::sync_with_stdio(0);cin.tie(0);

    solve();

    return 0;
}
