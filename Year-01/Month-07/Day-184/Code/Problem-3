// Problem-3
// Codeforces - 158 B

#include <bits/stdc++.h>
using namespace std;

void solve()
{
    int n;
    cin >> n;
    vector<int> d(n);
    for (int i = 0; i < n; i++)
    {
        cin >> d[i];
    }
    sort(d.begin(), d.end());

    int c1 = count(d.begin(), d.end(), 1);
    int c2 = count(d.begin(), d.end(), 2);
    int c3 = count(d.begin(), d.end(), 3);
    int c4 = count(d.begin(), d.end(), 4);
    int cnt = c4;
    cnt += c3;
    c1 -= c3;
    c3 = 0;
    if (c2 % 2 == 0 && c2 != 0)
    {
        cnt += (c2 / 2);
        c2 = 0;
    }
    else if(c2 % 2 != 0)
    {
        cnt += (ceil(c2 / 2.0));
        c2 = 0;
        c1 -= 2;
    }
    if (c1 > 0)
    {
        cnt += ceil(c1/4.0);
        c1 == 0;
    }

    cout << cnt << '\n';
}

int main()
{

    ios_base::sync_with_stdio(0);
    cin.tie(0);

    solve();

    return 0;
}
