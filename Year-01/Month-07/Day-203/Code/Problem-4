// Codeforces - 1945/problem/A

#include <bits/stdc++.h>
using namespace std;
#define fast_io ios_base::sync_with_stdio(0);cin.tie(0);
typedef long long ll;
#define fl(n) for(int i = 0 ; i < n ; i++)
#define vi(v,n) vector <int> v(n);
#define flvi(v,n) for(int i = 0 ; i < n ; i++){cin >> v[i];};
#define flvo(v,n) for(int i = 0 ; i < n ; i++){cout << v[i] << ' ';}; cout << '\n';
#define otn(r) cout << r << '\n'
#define ot(r) cout << r 
#define otc(r) cout << r << ' ' 

void solve(){
   ll i,e,u;
   cin >> i >> e >> u;
   ll tnt = i;
   if(e % 3 == 0){
        tnt += (e/3);
        tnt += (u+2)/3;
   }
   else if((e % 3 == 0) || ((u-(3-(e%3)))% 3) >= 0 ){
        tnt += ((e+2)/3);
        u -= (3-(e%3));
        tnt += (u+2)/3;
   }
   else{
        otn(-1);
        return;    
    }
    otn(tnt);    


}

int main(){

    fast_io;
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}
