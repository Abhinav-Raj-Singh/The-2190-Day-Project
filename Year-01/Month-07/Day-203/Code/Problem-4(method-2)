#define flvo(v,n) for(int i = 0 ; i < n ; i++){cout << v[i] << ' ';}; cout << '\n';
#define otn(r) cout << r << '\n'
#define ot(r) cout << r 
#define otc(r) cout << r << ' ' 

void solve(){
   ll a,b,c;
   cin >> a >> b >> c;
   
   if(((b+2)/3)*3 >(b+c)){
    otn(-1);
    return;
   }
   ll ans = a + ((b+c+2)/3);
   otn(ans);
   


}

