// Codeforces - 1872/problem/A

#include <bits/stdc++.h>
using namespace std;
#define fast_io ios_base::sync_with_stdio(0);cin.tie(0);
typedef long long ll;
#define fl(n) for(int i = 0 ; i < n ; i++)
#define vi(v,n) vector <int> v(n);
#define flvi(v,n) for(int i = 0 ; i < n ; i++){cin >> v[i];};
#define flvo(v,n) for(int i = 0 ; i < n ; i++){cout << v[i] << ' ';}; cout << '\n';
#define otn(r) cout << r << '\n'
#define ot(r) cout << r 
#define otc(r) cout << r << ' ' 

void solve(){
    ll a,b,c;
    cin >> a >> b >> c;
    ll ans = abs(a-b);
    if(ans % 2 == 0){
        ans /= 2;
    }
    else{
        ans /= 2;
        ans += 1;
    }
    cout << ((ans % c == 0)? (ans/c) : ((ans+c-1)/c)) << '\n';
}

int main(){

    fast_io;
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}
