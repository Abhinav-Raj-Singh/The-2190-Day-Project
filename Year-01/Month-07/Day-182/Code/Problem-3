// Problem-3
// Codeforces 160 A

#include <bits/stdc++.h>
using namespace std;

void solve()
{
    int n;
    cin >> n;
    vector<int> d(n);
    for (int i = 0; i < n; i++)
    {
        cin >> d[i];
    }
    
    
    int sum = accumulate(d.begin(),d.end(),0);
    sort(d.begin(),d.end());
    int cnt = 0;
    int sumb = 0;
    for(int i = (n-1) ; i >= 0  ; i--){
        sumb += d[i];
        cnt++;
        if(sumb > (sum/2.0)){
            cout << cnt << '\n';
            return;
        }

    }
    

}

int main()
{
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    solve();
}
