// Problem-1(method-2)
// Codeforces - 2259/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
  int n, k;
  cin >> n >> k;
  string s;
  cin >> s;
  int ans = 0 ;
  for(int i = 0; i < n/k ;i++){
    bool check = false;
    for(int j = i*k ;j < (i+1)*k ; j++){
        if(s[j] == '0') check = true;
    }
    ans += !check;
  }
   cout << ans << '\n';
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
