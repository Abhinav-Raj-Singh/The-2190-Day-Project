// Problem-3
// Codeforces - 1878/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
   int n , k;
   cin >> n >> k;
   vector <int> d(n);
   for(int i = 0 ; i < n ; i++){
    cin >> d[i];
   }
   cout << (find(d.begin(),d.end(),k)!= d.end()? "YES" : "NO") << '\n';
   
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
