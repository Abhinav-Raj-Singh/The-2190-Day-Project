#include <bits/stdc++.h>
using namespace std;
const int N = 1e6;
int cnt[N+1];



void solve(){
     int n;
     cin >> n;
     int cnt = 0 ; 
     for(int i = 1; i*i <= n ; i++){
        if(n%i == 0){
            cnt++;
            if(i != n/i){
                cnt++;
            }
        }
     }
     cout << cnt << '\n';
   
    

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);

    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
