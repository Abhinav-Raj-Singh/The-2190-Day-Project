// Problem-3
// Codeforces - 1927/problem/A

#include <bits/stdc++.h>
using namespace std;
#define fast_io ios_base::sync_with_stdio(0);cin.tie(0);
typedef long long ll;
#define fl(n) for(int i = 0 ; i < n ; i++)
#define vi(v,n) vector <int> v(n);
#define flvi(v,n) for(int i = 0 ; i < n ; i++){cin >> v[i];};
#define flvo(v,n) for(int i = 0 ; i < n ; i++){cout << v[i] << ' ';}; cout << '\n';
#define otn(r) cout << r << '\n'
#define ot(r) cout << r 
#define otc(r) cout << r << ' ' 

void solve(){
    ll n;
    cin >> n;
    string d;
    cin >> d;
    ll s = -1;
    ll e = -1;
    fl(n){
        if(d[i] == 'B' && s == -1){
            s = i;
        }
        else if(d[i] == 'B' && s != -1){
            e = i;
        }
    }
    ll mx = max(s,e);
    ll mn = min(s,e);
    if(mx >= 0 && mn < 0){
        otn(1);
        return;
    }
    else if(mx < 0){
        otn(0);
        return ;
    }
    else{
    otn(abs(e-s)+1);
    }
}

int main(){

    fast_io;
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}
