// Problem-2
// Codeforces - 1931/problem/A

#include <bits/stdc++.h>
using namespace std;


void solve(){
     int n;
     cin >> n;
     n -= 3;
     for(int i = 1; i <= 3 ; i++){
        int x = max(0,n-(3-i)*25);
        n -= x;
        cout << char(x+'a');
    }
    
    cout <<  '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);

    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
