#include <bits/stdc++.h>
using namespace std;
const int N = 1e6;
int cnt[N+1];

void calculate(){

   
    for(int i = 1 ; i <= N ; i++){
        for(int j = i ; j <= N ; j += i){
            cnt[j]++;
        }
    }
}


void solve(){
     int n;
    cin >> n;
    cout << cnt[n] << '\n';
   
    

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    calculate();
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
