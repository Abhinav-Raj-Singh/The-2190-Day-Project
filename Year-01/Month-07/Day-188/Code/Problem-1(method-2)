class Solution {
  public:
    int countWords(vector<string> &list) {
            

            // sort(list.begin(),list.end());
            unordered_map<string,int> m;
            for(int i = 0 ; i < list.size();i++){
                m[list[i]]++;
            }
            int re = 0;
            // for(int i = 0 ; i < list.size();i++){
            //     if(m[list[i]] == 2){
            //         re++;
            //         i++;
            //     }
            // }
            for(auto &c : m){
                if(c.second == 2){
                    re++;
                }
            }
            return re;

        

    }
};
