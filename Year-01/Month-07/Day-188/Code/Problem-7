// Codeforces 1692 A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    vector <int> d(4);
    for(int i = 0 ; i < 4 ; i++){
        cin >> d[i];
        
    }
    int r = d[0];
    sort(d.begin(),d.end());
    for(int i = 0 ; i < 4 ; i++){
        if(d[i] == r){
            cout << (3-i) << '\n';
            return;
        }
    }


}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }

    return 0;
}
