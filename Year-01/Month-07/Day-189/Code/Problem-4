// Problem-4
// Codeforces 1901 A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int g , n;
    cin >> g >> n;
    vector<int> d(g);
    for(int i = 0 ; i < g ;i++){
        cin >> d[i];
    }
    // for(auto &c :d){
    //     cout << c << ' ' ;
    // }
    // cout << '\n';

    vector <int> r;
    for(int i = 0 ; i <=g ; i++){
        if(i == 0){
            r.push_back(d[i]);
        }
        else if( i != 0 && i != g){
            r.push_back(d[i]-d[i-1]);
            
        }
        else if(i == g){
            r.push_back(2*(n-d[g-1]));
            
        }
        
    }
    sort(r.begin(),r.end());
    // for(auto &c :r){
    //     cout << c << '\n';
    // }
    cout << r.back() << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;

}
