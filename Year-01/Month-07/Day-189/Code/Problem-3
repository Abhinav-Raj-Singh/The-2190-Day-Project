// Problem-3
// Codeforces 1857 A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    vector<int> d(n);
    for(int i = 0 ; i < n ; i++){
        cin >> d[i];
    }    
    int sum = accumulate(d.begin(),d.end(),0);
    cout << (sum%2 == 0 ? "YES" : "NO") << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;

}
