// Problem-1
// Codeforces - 318 A

#include <bits/stdc++.h>
using namespace std;

void solve()
{
    long long n, k;
    cin >> n >> k;
    long long pt = ((long long)ceil(n / 2.0));

    if (pt >= k)
    {
        cout << (1 + ((k - 1) * 2)) << '\n';
    }
    else
    {
        cout << (2 + (((k - pt-1)) * 2)) << '\n';
    }
}

int main()
{

    ios_base::sync_with_stdio(0);
    cin.tie(0);

    solve();

    return 0;
}
