// Problem-4(method-2)
// Codeforces - 479 A

#include <bits/stdc++.h>
using namespace std;

void solve()
{
    int a, b, c;
    cin >> a >> b >> c;
    int ans = (a+b+c);
    ans = max((a+b)*c , ans);
    ans = max(a*(b+c) , ans);
    ans = max(a*b*c, ans);

    cout << ans << '\n';
}

int main()
{

    ios_base::sync_with_stdio(0);
    cin.tie(0);

    solve();

    return 0;
}
