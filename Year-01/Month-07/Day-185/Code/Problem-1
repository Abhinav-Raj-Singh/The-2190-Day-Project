// Problem-1
// Codeforces - 25A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    vector <int> d(n);
    int even = 0;
    int odd = 0;
    for(int i = 0 ; i < n ; i++){
        cin >> d[i];
    }
    for(int i = 0 ; i < n ; i++){
        if(d[i] % 2 == 0){
            even++;
        }
        else{
            odd++;
        }
    }
    for(int i = 0 ; i < n ; i++){
        if(even > odd){
            if(d[i] % 2 != 0){
                cout << (i+1) << '\n';
                return;
            }
        }
        else if(odd > even){
            if(d[i] % 2 == 0){

                cout << (i+1) << '\n';
                return ;
            }
        }
    }
    

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();
    return 0;
}
