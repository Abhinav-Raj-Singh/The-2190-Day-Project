// Problem-1(method-2)
// Codeforces - 25A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    vector <int> d(n);
    int cnt[2] {};
    for(int i = 0 ; i < n ;i++){
        cin >> d[i];
        cnt[d[i]%2]++;
    }
    for(int i = 0 ; i < n ;i++){
        if(cnt[d[i]%2] == 1){
            cout << i+1 << '\n';
            return;
        }
    }
    

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();
    return 0;
}
