// Problem-3
// Codeforces - 230A

#include <bits/stdc++.h>
using namespace std;

void solve(){
  int n , s;
  cin >> s >> n;
  vector<pair<int,int>> d;
  for(int i = 0 ; i < n ; i++){
    int a , b;
    cin >> a >> b;
    d.push_back({a,b});
  }
  sort(d.begin(),d.end());
  for(int i = 0 ; i < n ; i++){
    if(s > d[i].first){ 
    s += d[i].second;
    }
    else if(s <= d[i].first){
        cout << "NO" << '\n';
        return ;
    }
}
cout << "YES" << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();
    return 0;
}
