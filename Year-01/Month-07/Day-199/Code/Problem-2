// Problem-2
// Codeforces - 1907/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    string s;
    cin >> s;
    string r = "abcdefgh";
    
    for(int i = 1 ; i <= 8 ; i++){
        if(r[i-1] != s[0]){
        cout << r[i-1] << (s[1]-'0') << '\n';
        }
        if(i != (s[1]-'0')){
        cout << (s[0]) << i << '\n';
        }
    }
}

int main(){
    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
