// Problem-1 
// Codeforces - 1921/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    vector <int> d(8);
    for(int i = 0 ; i < 8 ;i++){
        cin >> d[i];
    }
    int r = max({abs(d[2]-d[0]),abs(d[1]-d[3])});
    cout << (r*r) << '\n';
}

int main(){
    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
