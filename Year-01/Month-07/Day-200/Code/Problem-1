// Problem-1
// Codeforces - 2123/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    vector <int> d;
    for(int i = 0 ; i < n ; i++){
        if(i >= 4 && i != 0){
            d.push_back(i % 4);
        }
        else{
            d.push_back(i);
        }
        
    }
    sort(d.begin(),d.end());
    int cnt0 = count(d.begin(),d.end(),0);
    int cnt1 = count(d.begin(),d.end(),1);
    int cnt2 = count(d.begin(),d.end(),2);
    int cnt3 = count(d.begin(),d.end(),3);
    
    cout << ((cnt0 == cnt3 && (cnt1 == cnt2)) ? "Bob" : "Alice" ) << '\n';
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}
