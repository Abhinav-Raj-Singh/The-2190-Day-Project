// Problem-1(method-2)
// Codeforces - 2123/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    vector <int> d(4);
    for(int i = 0 ; i < n ; i++){
        d[i%4]++;
    }
    cout << ((d[0] == d[3] && (d[1] == d[2])) ? "Bob" : "Alice" ) << '\n';

        
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}
