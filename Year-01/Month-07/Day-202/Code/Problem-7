// Problem-7
// Codeforces 1980/problem/A

#include <bits/stdc++.h>
using namespace std;
#define fast_io ios_base::sync_with_stdio(0);cin.tie(0);
typedef long long ll;
#define fl(n) for(int i = 0 ; i < n ; i++)
#define vi(v,n) vector <int> v(n);
#define flvi(v,n) for(int i = 0 ; i < n ; i++){cin >> v[i];};
#define flvo(v,n) for(int i = 0 ; i < n ; i++){cout << v[i] << ' ';}; cout << '\n';
#define otn(r) cout << r << '\n'
#define ot(r) cout << r 
#define otc(r) cout << r << ' ' 

void solve(){
    
    ll n , m;
    cin >> n >> m;
    string s;
    cin >> s;
    vector <int> hashi(26,0);
    for(int i = 0 ; i < s.size();i++){
        hashi[s[i]-'A']++;
    }
    int cnt = 0 ;
  
    for(int i = 0; i < 7 ;i++){
            cnt += (hashi[i] >= m ? 0 : m-hashi[i]);
    }
   
    otn(cnt);
}

int main(){

    fast_io;
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}
