// Codeforces 2000/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    if((n >= 102 && n <= 109) || (n >= 1010 && n <= 1099)){
        cout << "YES" << '\n';

    }
    else{
        cout << "NO" << '\n';

    }
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
