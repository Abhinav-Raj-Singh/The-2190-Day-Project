// Problem-3(method-2)
// Codeforces 2000/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    string s;
    cin >> s;
    if(s.size() >= 3 && s[0] == '1' && s[1] == '0' && s[2] != '0' && (stoi(s.substr(2)) >=2 )){
        cout << "YES" << '\n';
    }
    else{
        cout << "NO" << '\n';

    }
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
