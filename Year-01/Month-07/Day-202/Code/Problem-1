// Problem-1
// Codeforces 2014/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n , k;
    cin >> n >> k;
    vector <int> d(n);
    int gld = 0;
    int cnt = 0;
    for(int i = 0 ; i < n ; i++){
        cin >>d[i];
        if(d[i] >= k){
            gld += d[i];
        }
        else if(d[i] == 0 && gld > 0){
            gld--;
            cnt++;
        }
    }
    cout << cnt << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
