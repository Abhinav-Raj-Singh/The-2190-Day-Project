// Problem-2
// Codeforces 2008/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int a,b;
    cin >> a >> b;
    if(a > 0 && b == 0){
        if(a % 2 == 0){
            cout << "YES" << '\n';
        }
        else{
            cout << "NO" << '\n';

        }
    }
    else if(a == 0 && b > 0){
        if(b % 2 == 0){
            cout << "YES" << '\n';
            
        }
        else{
            cout << "NO" << '\n';
            
        }
    }
    else {
        if(((a*1)+(b*2)) % 2 == 0){
            cout << "YES" << '\n';

        }
        else{
            cout << "NO" << '\n';
        }
    }

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
