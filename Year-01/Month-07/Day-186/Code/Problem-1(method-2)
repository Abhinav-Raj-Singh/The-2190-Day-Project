// Problem-1(method-2)
// Codeforces 750 A
#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n,k;
    cin >> n >> k;
  
    int solve = 0;
    for(int i = 1 ; i <= n ; i++){
        if(k + 5*i <= 240){
            solve++;
            k += 5*i;
        }
    }
    cout << solve << '\n';
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);

    solve();

    return 0;
}
