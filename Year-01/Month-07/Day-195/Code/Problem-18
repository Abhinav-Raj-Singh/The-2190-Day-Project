// Problem-18
// Codeforces - 219432/problem/S

#include <bits/stdc++.h>
using namespace std;

void solve()
{
    int a, b;
    cin >> a >> b;
    int mn = min(a,b);
    int mx = max(a,b);
    int sum = 0 ; 
    for(int i = mn+1 ; i < mx ; i++){
        if(i % 2 != 0){
            sum += i;
        }
        
    }
    cout << sum << '\n';


}

int main()
{

    ios_base::sync_with_stdio(0);cin.tie(0);
        int t;
        cin >> t;
        while(t--){       
        solve();
        }
        
    

    return 0;
}
