// Codeforces - 219432/problem/C

#include <bits/stdc++.h>
using namespace std;


void solve(){
    int n;
    cin >> n;
    vector <int> d(n);
    int even = 0;
    int odd = 0 ;
    int positive = 0;
    int negative = 0;
    for(int i = 0 ; i < n; i++){
        cin >> d[i];
        if(abs(d[i] % 2 == 0 )){
            even++;
        }
        else{
            odd++;
        }
        if(d[i] > 0){
            positive++;
        }
        else if(d[i] < 0) {
            negative++;
        }
    }
    cout << "Even: " << even << '\n';
    cout << "Odd: " << odd << '\n';
    cout << "Positive: " << positive << '\n';
    cout << "Negative: " << negative << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();

    return 0;
}
