#include <bits/stdc++.h>
using namespace std;

void solve()
{
   int n;
   cin >> n;

   for(int i = 1 ; i<= n ; i++){
        string s ;
        for(int j = 1; j <= i ; j++){
            s.push_back('*');
        }
        cout << s << '\n';
   }


}

int main()
{

    ios_base::sync_with_stdio(0);cin.tie(0);
    
    
        solve();
    

    return 0;
}
