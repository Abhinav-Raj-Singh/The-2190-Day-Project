#include <bits/stdc++.h>
using namespace std;


void solve(){
    int n;
    cin >> n;
    for(int i = 2 ; i < n; i++){
        if(n % i == 0 && (i != n)){
            cout << "NO" << '\n';
            return ;
        }
    }
    cout << "YES" << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();

    return 0;
}
