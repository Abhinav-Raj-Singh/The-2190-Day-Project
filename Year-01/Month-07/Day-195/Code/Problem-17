// Codeforces - 219432/problem/R

#include <bits/stdc++.h>
using namespace std;

void solve()
{
   int m , n;
   while(cin >> m >> n){
        if(m <= 0 || n <= 0){
            return;
        }
        else{
            long long sum = 0;
            int mx = max({n,m});
            int mn = min(n,m);
            for(int i = mn; i <= mx ;i++){
                sum += i;
                cout << i << ' ';
            }
            cout << "sum =" << sum << '\n';
            
        }
   }


}

int main()
{

    ios_base::sync_with_stdio(0);cin.tie(0);
       
        solve();
        
    

    return 0;
}
