#include <bits/stdc++.h>
using namespace std;

void solve()
{
   long long n;
   cin >> n;
    if(n == 0){
        cout << 0 << '\n';
        return ;
    }
   while(n >= 1){
        cout << (n%10) << ' ';
        n /= 10;
   }
   cout << '\n';


}

int main()
{

    ios_base::sync_with_stdio(0);cin.tie(0);
        int t;
        cin >> t;
        while(t--){
        solve();
        }
    

    return 0;
}
