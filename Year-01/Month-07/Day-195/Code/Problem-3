#include <bits/stdc++.h>
using namespace std;


void solve(){
    int a, b, c,d;
    cin >> a >> b >> c >> d;
    a %= 100;
    b %= 100;
    c %= 100;
    d %= 100;

    int ans = a*b*c*d;
    int l_t_d = ans %100;
    if(l_t_d <= 9){
        cout << 0 << l_t_d << '\n';
    }
    else {
        cout <<  l_t_d << '\n';

    }

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();

    return 0;
}
