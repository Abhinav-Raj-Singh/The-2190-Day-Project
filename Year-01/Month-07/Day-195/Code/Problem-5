#include <bits/stdc++.h>
using namespace std;


void solve(){
    int n;
    cin >> n;
    if(n == 1){
        
        cout << -1 << '\n';
        return;
    }
    for(int i = 1 ; i<= n ; i++){
        if(i % 2 == 0){
        cout << i << '\n';
    }
    
        
    }

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();

    return 0;
}
