// Problem-2
// Codeforces 1512/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    vector <int> d(n);
    unordered_map<int,pair<int,int>> r;
    for(int i = 0 ; i < n;i++){
        cin >> d[i];
        r[d[i]].first += 1;
        r[d[i]].second = i+1;
    }
    for(auto &c : r){
        if(c.second.first == 1){
            cout << c.second.second << '\n';
            return ;
        }
    }

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }

    return 0;
}
