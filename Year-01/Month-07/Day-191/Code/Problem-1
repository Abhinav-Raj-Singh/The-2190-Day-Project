// Problem-1
// Codeforces 339 B

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n , m;
    cin >> n >> m;
    vector<int> d(m);
    for(int i = 0 ; i < m ; i++){
        cin >> d[i];
    }
    long long ans = d[0]-1;

    for(int i = 1 ; i < m ; i++){
        if(d[i] > d[i-1]){
            ans += (d[i]-d[i-1]);
        }
        else if(d[i] < d[i-1]){
            ans += ((n-d[i-1])+d[i]);
        }
        else if(d[i] == d[i-1]){
            ans += 0;
        }
    }
    cout << ans << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();

    return 0;
}
