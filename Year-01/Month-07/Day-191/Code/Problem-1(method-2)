// Problem-1(method-2)
// Codeforces 339 B

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n , m;
    cin >> n >> m;
    vector<int> d(m);
    for(int i = 0 ; i < m ; i++){
        cin >> d[i];
    }
    long long ans = d[0]-1;

    for(int i = 1 ; i < m ; i++){
        ans += ((d[i] >= d[i-1]) ? (d[i]-d[i-1]) : (n-d[i-1]+d[i]));
    }
    cout << ans << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();

    return 0;
}
