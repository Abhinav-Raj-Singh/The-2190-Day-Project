// Problem-4
// Codeforces 1409/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
   long long a ,b ;
   cin >> a >> b;
   long long ans = 0;
   long long d = abs(a-b);
   if(d == 0){
    cout << ans << '\n';
    
   }
   else{
    if(d % 10 != 0){
        ans+= 1;
    }
    
    d /= 10;
    ans += d;
    cout << ans << '\n';
   }


}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }

    return 0;
}
