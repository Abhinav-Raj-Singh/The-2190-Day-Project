void solve(){
    int n;
    cin >> n;
    vector <int> d(n);
    vector <int> e(n);
    vector <int> f(n);

    for(int i = 0 ; i < n ; i++){
        cin >> d[i] >> e[i] >> f[i];
    }
    int a = accumulate(d.begin(),d.end(),0);
    int b = accumulate(e.begin(),e.end(),0);
    int c = accumulate(f.begin(),f.end(),0);
    
    cout << ((a==b && b==c && c == 0) ? "YES" : "NO" ) << '\n';
}



