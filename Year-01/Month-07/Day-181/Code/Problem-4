void solve(){
    string s;
    cin >> s;
    int cnt = 0 ; 
    vector <char> d;
    for(int i = 0 ; i < s.size() ; i++){
        if(s[i] == 'h' && cnt == 0){
            d.push_back(s[i]);
            cnt = 1;
        }
        else if(s[i] == 'e' && cnt == 1){
            d.push_back(s[i]);
            cnt = 2;

        }
        else if(s[i] == 'l' && cnt == 2){
            d.push_back(s[i]);
            cnt = 3;

        }
        else if(s[i] == 'l' && cnt == 3){
            d.push_back(s[i]);
            cnt = 4;

        }
        else if(s[i] == 'o' && cnt == 4){
            d.push_back(s[i]);
            cnt = 5;

        }
    }
    string r;
    for(int i = 0 ; i < d.size() ; i++){
        r.push_back(d[i]);
    }
    cout << (r == "hello" ? "YES" : "NO") << '\n';
}



