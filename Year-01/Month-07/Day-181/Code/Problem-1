template<typename T> void _print(vector<T> v1){
    cerr << "[ ";
    for(T i : v1){
        
        _print(i);
        cerr << " " ;
    } 
    cerr << " ]" << '\n';
}

template<typename T> void _print(set<T> s1){
    cerr << "[ ";
    for(T i : s1){
        
        _print(i);
        cerr << " " ;
    } 
    cerr << " ]" << '\n';
}

void solve(){
    string s;
    cin >> s;
    transform(s.begin(),s.end(),s.begin(),[] (char c){
        return tolower(c);
    });
    // cout << s << '\n';
    for(int i = 0 ; i < s.size() ; i++){
        if(s[i] == 'a' || s[i] == 'e' || s[i] == 'i' || s[i] == 'o' || s[i] == 'u' || s[i] == 'y'){
            s.erase(i,1);
            i--;
        }
        else{
            cout << '.' << s[i];
        }    
    }
    cout << '\n';
}



