// Problem-2
// Codeforces 1399 A

#include <bits/stdc++.h>
using namespace std;

void solve(){
   int n;
   cin >> n;
   vector <int> d(n);
   int diff = 0;
   for(int i = 0 ; i < n ; i++){
    cin >> d[i];
   }
   sort(d.begin(),d.end());
   for(int i = 1 ; i < n ;i++){
        diff = max(diff,d[i]-d[i-1]);
   }
   cout << ((diff == 1 || diff == 0)? "YES" : "NO") << '\n';

}


int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }

    return 0;
}
