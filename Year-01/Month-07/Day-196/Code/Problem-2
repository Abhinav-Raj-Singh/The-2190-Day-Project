// Codeforces - 219432/problem/W

#include<bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    int r = 1;
    int p = n-1;
    for(int i = 0 ; i < (2*n) ;i++){
        for(int j = p ; j>=1 ;j--){
            cout << " " ;
        }
        for(int j = 1 ; j <= r ;j++){
            cout << "*"; 
        }
        cout << '\n';
            if(i < n-1){
            p--;
            r += 2;
            }
            if(i == n-1){
                r = (2*n)-1;
                
                p = 0;
            }
            if(i > n-1){
                r -= 2;
                p++;
            }

    }
}

int main(){
    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();
    return 0;
}
