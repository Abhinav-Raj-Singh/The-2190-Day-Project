#include<bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    int r = 1;
    int p = n-1;
    for(int i = 0 ; i < n ;i++){
        for(int j = p ; j>=1 ;j--){
            cout << " " ;
        }
        for(int j = 1 ; j <= r ;j++){
            cout << "*"; 
        }
        cout << '\n';
            p--;
            r += 2;

    }
}

int main(){
    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();
    return 0;
}
