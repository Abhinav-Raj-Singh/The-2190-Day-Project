// Problem-4
// Codeforces - 219432/problem/J

#include <bits/stdc++.h>
using namespace std;

void solve()
{
    int n;
    cin >> n;
    for (int i = 2; i <= n; i++)
    {
        bool check = true;
        for (int j = 2; j <= i; j++)
        {
            if (i % j == 0 && j != i)
            {
                check = false;
                break;
            }
            else
            {
                check = true;
            }
        }
        if (check == true)
        {
            cout << i << ' ';
        }
    }
    cout << '\n';
}

int main()
{
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    solve();
    return 0;
}
