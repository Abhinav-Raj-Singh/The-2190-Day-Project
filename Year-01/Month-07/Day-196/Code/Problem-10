#include <bits/stdc++.h>
using namespace std;

void solve()
{
    int a ,b ,c;
    cin >> a >> b >> c;
    for(int i = a ; i <= b ; i++){
        if(i % c == 0){
            cout << i << '\n';
            return;
        }
    }
    cout << -1 << '\n';

    
}

int main()
{
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    solve();
    return 0;
}
