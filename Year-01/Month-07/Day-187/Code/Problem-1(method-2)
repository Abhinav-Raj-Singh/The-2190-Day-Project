// Problem-1(method-2)
// Codeforces 4 C

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    map <string ,int> d;
    for(int i = 0 ; i < n ; i++){
        string s;
        cin >> s;
        if(d[s] != 0){
            cout << s << d[s] << '\n';
            
        }
        
        else{
            
            cout << "OK"<< '\n'; 
        }
        d[s]++;
    }
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();
    return 0;

}
