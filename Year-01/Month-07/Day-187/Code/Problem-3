// Problem-3
// Codeforces 1669 A


#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    int ans = 0;
    if(n >= 1900){
        ans = 1;
    }
    else if(n <= 1899 && n >= 1600){
        ans = 2;
    }
    else if(n <= 1599 && n >= 1400){
        ans = 3;
    }
    else{
        ans = 4;
    }
    cout << "Division " << ans << '\n';

}


int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }

    return 0;
}
