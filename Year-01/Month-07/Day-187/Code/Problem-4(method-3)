// Problem-4(method-3)
// Codeforces 1475 A

#include <bits/stdc++.h>
using namespace std;


void solve()
{
    long long n;
    cin >> n;
    while(n%2 == 0){
        n /= 2;
    }
    cout << ((n == 1)? "NO" : "YES") << '\n';
}

int main()
{

    ios_base::sync_with_stdio(0);
    cin.tie(0);

    int t;
    cin >> t;
    while (t--)
    {
        solve();
    }

    return 0;
}
