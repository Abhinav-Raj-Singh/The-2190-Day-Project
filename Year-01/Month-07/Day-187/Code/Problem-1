// Problem-1
// Codeforces 4 C

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    map <string ,int> d;
    for(int i = 0 ; i < n ; i++){
        string s;
        cin >> s;
        auto e = d.find(s);
        if(e == d.end()){
            cout << "OK" << '\n';
            d[s] = 0;
        }
        else{
            d[s] += 1;

            cout << s << (d[s]) << '\n';
            
        }
    }
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();
    return 0;

}
