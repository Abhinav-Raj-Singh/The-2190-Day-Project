// Problem-4
// Codeforces 1475 A

#include <bits/stdc++.h>
using namespace std;

long long func(long long n){
    long long check = 0;
    while(n>1){
        if(n % 2 == 0 && n != 1){
            n = n/2;
        }
        else if(n != 1){
            check = n;
            break;
        }
    }
    return check;
}
void solve()
{
    long long n;
    cin >> n;
    long long p = n;
    if (p % 2 != 0)
    {
        cout << "YES" << '\n';
        return;
    }
    else if (n % 2 == 0)
    {
        int r = func(n);
        if (r % 2 != 0 && r != 1)
        {
            cout << "YES" << '\n';
        }
        else
        {
            cout << "NO" << '\n';
        }
    }
    else
    {
        cout << "NO" << '\n';
    }
}

int main()
{

    ios_base::sync_with_stdio(0);
    cin.tie(0);

    int t;
    cin >> t;
    while (t--)
    {
        solve();
    }

    return 0;
}
