// Problem-1
// Codeforces 1374/B

#include<bits/stdc++.h>
using namespace std;


void solve(){
    long long a ; 
    cin >> a;
    int cnt2 = 0;
    int cnt3 = 0;
    while(a % 2 == 0){
        cnt2++;
        a /= 2;
    }
    while(a % 3 == 0){
        cnt3++;
        a /= 3;
    }
    if(cnt2 <=cnt3 && a == 1){
        cout << (cnt3 + ((cnt3 -cnt2))) << '\n';
    }
    else{
        cout << -1 << '\n';
    }

}


int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }

    return 0;
}
