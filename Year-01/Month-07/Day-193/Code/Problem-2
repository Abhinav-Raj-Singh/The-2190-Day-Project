// Problem-2
// Codeforces 34/B

#include<bits/stdc++.h>
using namespace std;


void solve(){
    int n,m;
    cin >> n >> m;
    vector <int> d(n);
    for(int i = 0 ; i < n ;i++){
        cin >> d[i];
    }
    int cnt = 0;
    sort(d.begin(),d.end());
    
    cout << '\n';
    for(int i = 0 ; i < m ; i++){
        if(d[i] < 0){
            cnt += abs(d[i]);
        }
    }
    cout << cnt << '\n';

}


int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    
    solve();
   

    return 0;
}
