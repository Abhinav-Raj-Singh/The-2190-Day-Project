void rec(int n , const vector<int> &d){
  if(n == -1){
    cout << '\n';
        return ;
    }
    if(n%2 == 0){
    cout << d[n] << ' ';
}
    rec(n-1 ,d);
    
}
void solve(){
    int n;
    cin >> n;
    vector <int> d(n);
    flvi(d,n);
    n -= 1;
    rec(n,d);
}

int main(){

    fast_io;
    
        solve();
    
