// Problem-4
// Codeforces 2036/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){   
    int n;
    cin >> n;
    vector <int> d(n);
    for(auto &x :d){
        cin >> x;
    }
    for(int i = 1 ; i < n ; i++){
        if((abs(d[i]-d[i-1]) != 5) && abs(d[i]-d[i-1]) != 7){
            cout << "NO" << '\n';
            return ;
        }
    }
    
    cout << "YES" << '\n';
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
