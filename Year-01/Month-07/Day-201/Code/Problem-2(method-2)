// Problem-2(method-2)
// Codeforces 2050/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){   
    int n,m;
    cin >> n >> m;
    vector <int> d(n);
    for(int i = 0 ; i < n; i++){
        string s;
        cin >> s;
        d[i] = s.size();
    }
    int i = 0; 
    while( i < n && d[i] <= m){
        m -= d[i];
        i++;
    }
    cout << i << '\n';
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
