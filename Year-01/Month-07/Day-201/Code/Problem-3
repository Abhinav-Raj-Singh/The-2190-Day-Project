// Problem-3
// Codeforces 2037/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){   
    int n;
    cin >> n;
    vector <int> d(n+1);
    for(int i = 0 ; i < n; i++){
        int r;
        cin >> r;
        d[r]++;
    }
    int score = 0;
    for(auto &x : d){
        score += (x/2);
    }
    cout << score << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
