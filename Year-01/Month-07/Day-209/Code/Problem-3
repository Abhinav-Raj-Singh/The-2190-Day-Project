// Problem-3
// Codeforces-1822/problem/A

#include <bits/stdc++.h>
using namespace std;
#define fast_io ios_base::sync_with_stdio(0);cin.tie(0);
typedef long long ll;
#define fl(n) for(int i = 0 ; i < n ; i++)
#define vi(v,n) vector <int> v(n);
#define flvi(v,n) for(int i = 0 ; i < n ; i++){cin >> v[i];};
#define flvo(v,n) for(int i = 0 ; i < n ; i++){cout << v[i] << ' ';}; cout << '\n';
#define otn(r) cout << r << '\n'
#define ot(r) cout << r 
#define otc(r) cout << r << ' ' 


void solve(){
   int n , t;
   cin >> n >> t;
   vector <int> time (n+1);
   vector <int> en(n+1);
   multimap <int,pair<int,int> ,greater<int>> r;
   for(int i = 1 ; i < n+1 ; i++){
        cin >> time[i];
   }
   for(int i = 1 ; i < n+1 ; i++){
        cin >> en[i];
   }
   for(int i = 1 ; i < n+1 ; i++){
    r.insert({en[i],{time[i]+i-1,i}});
   }

   for(auto &c : r){
    if(c.second.first <= t){
        cout << c.second.second << '\n';
        return;
    }
   }
   cout << -1 << '\n';
}

int main(){

    fast_io;
        int t;
        cin >> t;
        while(t--){
        solve();
    }
    return 0;
}
