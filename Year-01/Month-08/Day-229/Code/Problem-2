// Problem-2
// Codeforces-1520/problem/A

#include <bits/stdc++.h>
using namespace std;


void solve(){
    int n;
    cin >> n;
    string s;
    cin >> s;
    s.erase(unique(s.begin(),s.end()),s.end());
    for(int i = 0 ; i < s.size() ; i++){
        int r = count(s.begin(),s.end(),s[i]);
        if(r > 1){
            cout << "NO" << '\n';
            return ;
        }
    }
    cout << "YES" << '\n';
    
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}

