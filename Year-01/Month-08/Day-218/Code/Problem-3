// Problem-3
// Codeforces-1611/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    string s;
    cin >> s;
    if((s.back()-'0') % 2 == 0){
        cout << 0 << '\n';
        return ;
    }
    else if((s[0]-'0')%2 == 0){
        
        cout << 1 << '\n';
    }
    else {
        for(int i = 1 ; i < s.size() ; i++){
            if((s[i] - '0')% 2 == 0){
                cout << 2 << '\n';
                return ;
            }
        }
        cout << -1 << '\n';
        
    }
    
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
