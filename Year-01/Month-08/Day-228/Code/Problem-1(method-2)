// Problem-1(method-2)
// Codeforces-1935/A

#include <bits/stdc++.h>
using namespace std;


void solve(){
    long long n;
    cin >> n;
    string s;
    cin >> s;
    string r = s;
    reverse(r.begin(),r.end());
    s = min(s,(r+s));
    cout << s << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
