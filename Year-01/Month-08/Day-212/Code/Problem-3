#include <bits/stdc++.h>
using namespace std;


void solve(){
  int n;
  cin >> n;
  vector<int> d(n);
  for(int i = 0 ; i < n ; i++){
    cin >> d[i];
  }
  int a ; int b;
  cin >> a >> b;
//   sort(d.rbegin(),d.rend());
  int sum = 0;
  for(int i = a ; i <= b ; i++){
    sum += d[i];
  }
  cout << sum << '\n';

      
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();
    return 0;
}
