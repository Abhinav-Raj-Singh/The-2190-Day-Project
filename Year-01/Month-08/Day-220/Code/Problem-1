#include <bits/stdc++.h>
using namespace std;


void solve(){
    int n;
    cin >> n;
    long long ans = 1;
    for(int i = 2 ; i <= n ; i++){
        ans *= i;
        
    }
    cout << ans << '\n';
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
