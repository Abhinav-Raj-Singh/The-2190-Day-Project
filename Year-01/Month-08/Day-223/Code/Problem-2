// Problem-2
// Codeforces-1551/problem/A

#include <bits/stdc++.h>
using namespace std;


void solve(){
    long long n;
    cin >> n;
    long long one = n/3;
    long long two = n/3;
    int r = (n-(one+(2*two)));
    one += ((r % 2 != 0 && r!=0) ? r : 0 );
    two += ((r % 2 == 0 && r!=0) ? (1) : 0 );
    cout << one << ' ' << two << '\n';
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
