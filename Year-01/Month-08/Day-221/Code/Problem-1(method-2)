// Problem-1(method-2)
// Codeforces-1607/problem/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    string s,p;
    cin >> s >> p;
    int cnt = 0;
    for(int i = 1 ; i < p.size() ; i++){
        int r = s.find(p[i-1]) - s.find(p[i]) ;
        cnt += abs(r);
    }
    cout << cnt << '\n';
}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
