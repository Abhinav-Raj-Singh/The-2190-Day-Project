#include <bits/stdc++.h>
using namespace std;


void solve(){
    long long n;
    cin >> n;
    vector <long long int> d(n);
    long long mx = INT_MIN;
    long long mn = INT_MAX;
    for(int i = 0 ; i < n ; i++){
        cin >> d[i];
        mx = max(mx,d[i]);
        mn = min(mn,d[i]);
    }
    cout << (mx - mn) << '\n'; 
    
    int max = INT_MAX;
}

int main(){
    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    
    return 0;
}
