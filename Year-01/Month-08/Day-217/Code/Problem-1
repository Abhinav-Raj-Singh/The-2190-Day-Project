// Problem-1
// Codeforces-1650/problem/A

#include <bits/stdc++.h>
using namespace std;


void solve(){
    string s,p;
    cin >> s >> p;
    for(int i = 0 ; i < s.size() ; i++){
        if(s[i] == p[0] && i%2 == 0){
            cout << "YES" << '\n';
            return ;
        }
    }
    cout << "NO" << '\n';
    
}

int main(){
    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    
    return 0;
}
