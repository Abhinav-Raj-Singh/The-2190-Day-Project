#include <bits/stdc++.h>
using namespace std;


void solve(){
    string s;
    cin >> s;
    if(s.size()%2 == 0 && s.substr(0,s.size()/2) == s.substr(s.size()/2,s.size()/2)){
        cout << "YES" << '\n';
    }
    else{
        
        cout << "NO" << '\n';
    }
    
}

int main(){
    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    
    return 0;
}
