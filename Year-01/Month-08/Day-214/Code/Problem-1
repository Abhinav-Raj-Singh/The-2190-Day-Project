// Codeforces-1714/problem/A

#include <bits/stdc++.h>
using namespace std;
#define fast_io ios_base::sync_with_stdio(0);cin.tie(0);
typedef long long ll;
#define fl(n) for(int i = 0 ; i < n ; i++)
#define vi(v,n) vector <int> v(n);
#define flvi(v,n) for(int i = 0 ; i < n ; i++){cin >> v[i];};
#define flvo(v,n) for(int i = 0 ; i < n ; i++){cout << v[i] << ' ';}; cout << '\n';
#define otn(r) cout << r << '\n'
#define ot(r) cout << r 
#define otc(r) cout << r << ' ' 

void solve(){
    int n,H,M;
    cin >> n >> H >> M;
    int ct = ((H*60)+M);
    vector<pair<int,int>> d(n);
    vector <int> fq;
    for(int i = 0 ; i < n ; i++){
        cin >> d[i].first >> d[i].second;
        int CT = ((d[i].first*60) + d[i].second);
        if(CT >= ct){
            fq.push_back(CT -ct);
        }
        else{
            fq.push_back((1440-ct)+(CT));
        }
    }
    sort(fq.begin(),fq.end());
    cout << ((fq[0]/60)) << ' ' << ((fq[0]%60)) << '\n';

}

int main(){

    fast_io;
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}
