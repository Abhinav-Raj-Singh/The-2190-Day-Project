// Codeforces-1660/problem/A

#include <bits/stdc++.h>
using namespace std;


void solve(){
    
    long long a ,b;
    cin >> a >> b;
    if(a == 0 && b >= 1){
        cout << 1 << '\n';
    }
    else{
        cout << ((a*1)+(b*2)+1) << '\n';

    }

    

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
    return 0;
}
