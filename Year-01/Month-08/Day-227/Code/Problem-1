// Problem-1
// Codeforces-problem/116/A

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    string s;
    cin >> n  >> s;
    int cnt1 = 0;
    int cnt2 = 0;
    for(int i = 0 ; i < n/2 ; i++){
        cnt1 += (s[i]-'0');
    }
    for(int i = n/2 ; i < n ; i++){
        cnt2 += (s[i]-'0');
    }
    int l1 = count(s.begin(),s.end(),'4');
    int l2 = count(s.begin(),s.end(),'7');
    cout << (((s.size() == l1+l2) && (cnt1 == cnt2))? "YES" : "NO") << '\n';

}

int main(){
    
    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();
    return 0;
}
