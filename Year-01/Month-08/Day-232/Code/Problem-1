#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    vector <int> d(n);
    for(int i = 0 ; i < n ; i++){
        cin >> d[i];
    }
    int min_ = min_element(d.begin(),d.end()) -d.begin();
    int max_ = max_element(d.begin(),d.end()) -d.begin();
    cout << min({
        max(min_,max_)+1,max(n-min_,n-max_),(min_+1+n-max_),(max_+1+n-min_)
    }) << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}
