// Problem-3
// Floyd's triangle

#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    int r = 1;
    for(int i = 0 ; i < n ; i++){
        for(int j = 0 ; j <= i ;j++){
            if(j != n){
            cout << r++ << ' ';
            }
            else{
                cout << r++ ;
            }
        }
        cout << '\n';

    }

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);
    int t;
    cin >> t;
    while(t--){
    solve();
    }
}
