// Codeforces-1744/problem/A

#include <bits/stdc++.h>
using namespace std;
#define fast_io ios_base::sync_with_stdio(0);cin.tie(0);
typedef long long ll;
#define fl(n) for(int i = 0 ; i < n ; i++)
#define vi(v,n) vector <int> v(n);
#define flvi(v,n) for(int i = 0 ; i < n ; i++){cin >> v[i];};
#define flvo(v,n) for(int i = 0 ; i < n ; i++){cout << v[i] << ' ';}; cout << '\n';
#define otn(r) cout << r << '\n'
#define ot(r) cout << r 
#define otc(r) cout << r << ' ' 

void solve(){
    int n;
    cin >> n;
    vector <int> d(n);
    for(int i = 0 ; i < n ; i++){
        cin >> d[i];
    }
    cin.ignore();
    string s;
    getline(cin,s);
    map <int,char> r;
    for(int i = 0 ; i < n ; i++){
        if(r.find(d[i]) == r.end()){
           r.insert({d[i],s[i]});
        }
        else if(r.find(d[i]) != r.end()){
            if(r[d[i]] != s[i]){
                otn("NO");
                return ;
            }
            
        }
    }
    otn("YES");
    
}

int main(){

    fast_io;
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}
