void solve(){
    int n;
    cin >> n;
    vector <int> d(n);
    for(int i = 0 ; i < n ; i++){
        cin >> d[i];
    }
    int cn0 = 0;
    int cn1 = 0;
    int cn2 = 0;
    int cn3 = 0;
    int cn5 = 0;
    
    for(int i = 0 ; i < n ; i++){
        if(d[i] == 0){
            cn0++;
        }
        else if(d[i] == 1){
            cn1++;
        }
        else if(d[i] == 2){
            cn2++;
        }
        else if(d[i] == 3){
            cn3++;
        }
        else if(d[i] == 5){
            cn5++;
        }
        if(cn0 >= 3 && cn1 >= 1 && cn2 >= 2 && cn3 >= 1 && cn5 >= 1){
            cout << (i+1) << '\n';
            return;
        }
    }
    cout << 0 << '\n';

}



