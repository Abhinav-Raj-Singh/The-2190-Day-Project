}

void solve(){
    int n ;
    cin >> n;
    vector <int> a(n);
    vector <int> b(n);
    for(int i = 0 ; i < n; i++){
        cin >> a[i];
    }for(int i = 0 ; i < n; i++){
        cin >> b[i];
    }

    int ans = 1;
    for(int i = 0 ; i < n;i++){
        if(a[i] > b[i]){
            ans += (a[i]-b[i]);
        }
    }   
    cout << ans << '\n';
}



