template<typename T> void _print(vector<T> v1){
    cerr << "[ ";
    for(T i : v1){
        
        _print(i);
        cerr << " " ;
    } 
    cerr << " ]" << '\n';
}

template<typename T> void _print(set<T> s1){
    cerr << "[ ";
    for(T i : s1){
        
        _print(i);
        cerr << " " ;
    } 
    cerr << " ]" << '\n';
}

void solve(){
    int n;
    cin >> n;
    vector <int> d(n+1);
    int ans = 0;
    for(int i = 1 ; i < (n+1) ; i++){
        int a;
        cin >> a;
        ++d[a];
        if(d[0] >= 3 && d[1] >= 1 && d[2] >= 2 && d[3] >= 1 && d[5] >= 1 && ans == 0){
            ans = i;
            
        }
    }
   
    cout << ans << '\n';

}



