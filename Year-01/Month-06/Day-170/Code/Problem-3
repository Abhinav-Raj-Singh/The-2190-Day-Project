void solve(){
    int n , s , x;
    cin >> n >> s >> x;
    vector <int> d(n);
    for(int i = 0 ; i < n ;i++){
        cin >> d[i];
    }
    int sum = accumulate(d.begin(),d.end(),0);
    if((((s-sum == 0 )|| ((s-sum)%x ==0))) && s >= sum){
        cout << "YES" << '\n';
    }
    else {
        cout << "NO" << '\n';
        
    }
