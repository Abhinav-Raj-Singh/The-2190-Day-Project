void solve(){
    int n; 
    cin >> n;
    vector <int> d(n);
    for(int i = 0 ; i < n;i++){
        cin >> d[i];
    }
    sort(d.begin(),d.end());
    d[0]++;
    int product = 1;
    for(int i = 0 ; i < n;i++){
        product *= d[i];
    }
    cout << product << '\n';
}



