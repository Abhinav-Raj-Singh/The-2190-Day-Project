template<typename T> void _print(set<T> s1){
    cerr << "[ ";
    for(T i : s1){
        
        _print(i);
        cerr << " " ;
    } 
    cerr << " ]" << '\n';
}

void solve(){
    int n ;
    cin >> n;
    string s;
    cin >> s;
    string original = s;
    int ans = 0;
    for(int i = 0 ; i < n ; i++){
        if(s[i] == '0'){
            s[i] = '1';
        }
        else{
            s[i] = '0';
        }
        ans += count(s.begin(),s.end(),'1');
        s = original;
    }
    cout << ans << '\n';

}



