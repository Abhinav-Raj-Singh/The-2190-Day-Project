    } 
    cerr << " ]" << '\n';
}

void solve(){
    int n; 
    cin >> n;
    
    long long L = 0; 
    long long R = 1000000001;

    for(int i = 1 ; i <= n; i++){
        long long w ;
        cin >> w;
        if(i%2 != 0){
            R = min(w,R);
        }
        else if(i % 2 == 0){
            L = max(w,L);
        }
    }
    cout << (((n % 2 ==0) && (L + 2 <= R)) ? "YES" : "NO") <<'\n';

}



