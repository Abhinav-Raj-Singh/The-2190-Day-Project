void solve(){
   int n; 
   cin >> n;
   vector <int> odd(0); 
   vector <int> even(0);
   int change = 0 ;
   for(int i = 1 ; i <= (2*n);  i++){
        int a ; 
        cin >> a;
        if(i%2 == 0){
            even.push_back(a);
        }
        else if(i%2 != 0){
            odd.push_back(a);
        }
        
   } 
        // debugva(odd);
        // debugva(even);
        // debugv(odd.size());
        // debugv(even.size());
        // debugv(odd[0]);
        // debugv(odd[1]);
        // debugv(even[0]);
        // debugv(even[1]);
   for(int i = 0 ; i < (n); i++){
        
        for(int j = 0 ; j < n; j++){
            if(odd[i] == even[j]){
                change++;
            }
        }
        
   }
   cout << change << '\n';
}



