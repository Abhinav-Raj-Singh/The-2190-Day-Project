int checker(int a, int b , int c, int &ans1){
    if(c == a+b){
        ans1++;
    }
    return 0;
}

void solve(){
    vector <int> d(4);
    for(int i = 0 ; i < 4 ;i++){
        cin >> d[i];
    }
    // vector <int> d;
    int a = d[0] + d[1];
    int b = d[2] - d[1];
    int c = d[3] - d[2];
    
    int ans1 = 0;
    int ans2 = 0;
    int ans3 = 0;
    checker(d[0],d[1],a , ans1);
    checker(a,d[1],d[2] , ans1);
    checker(a,d[2],d[3] , ans1);

    checker(d[0],d[1],b , ans2);
    checker(b,d[1],d[2] , ans2);
    checker(b,d[2],d[3] , ans2);
    
    checker(d[0],d[1],c , ans3);
    checker(c,d[1],d[2] , ans3);
    checker(c,d[2],d[3] , ans3);    
    
    cout << max({ans1,ans2,ans3}) << '\n';
}



