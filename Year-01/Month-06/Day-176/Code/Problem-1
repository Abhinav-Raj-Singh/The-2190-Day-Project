void solve(){
    vector <int> d(4);
    for(int i = 0 ; i < 4 ;i++){
        cin >> d[i];
    }
    // vector <int> d;
    int a = d[0] + d[1];
    int b = d[2] - d[1];
    int c = d[3] - d[2];
    
    int ans1 = 0;
    int ans2 = 0;
    int ans3 = 0;
    if(a == d[0] + d[1] ){
        ans1++;
    }
    if(d[2] == d[1] + a){
        ans1++;
    }
    if(d[3] == d[2] + a){
        ans1++;
    }

    if(b == d[0] + d[1] ){
        ans2++;
    }
    if(d[2] == d[1] + b){
        ans2++;
    }
    if(d[3] == d[2] + b){
        ans2++;
    }

    if(c == d[0] + d[1] ){
        ans3++;
    }
    if(d[2] == d[1] + c){
        ans3++;
    }
    if(d[3] == d[2] + c){
        ans3++;
    }
    cout << max({ans1,ans2,ans3}) << '\n';
}



