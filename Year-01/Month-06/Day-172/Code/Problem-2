void solve(){
    int n ;
    cin >> n;
    vector <int> d(n);
    for(int i = 0 ; i < n; i++){
        cin >> d[i];
    }
    int a = count(d.begin(),d.end(),-1);
    int b = count(d.begin(),d.end(),0);
    if(a == 1){
        cout << ((a*2)+b) << '\n';
    }
    else if(a % 2 == 0){
        cout << b << '\n';
    }
    else if(a % 2 != 0){
        cout << (((a % 2)*2)+b) << '\n';
    }
}



