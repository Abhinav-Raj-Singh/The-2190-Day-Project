    } 
    cerr << " ]" << '\n';
}

void solve(){
    int n ;
    int k ;
    cin >> n >> k;
    if(n % 2 == 0  && n >= (2*k)){
        cout << "YES" << '\n';

        for(int i = 0 ; i < k; i++){
            cout << (i ? 2 : (n-((k-1)*2))) << " \n"[i == k-1];
        }
    }
    else if(n % 2 == k % 2 && n >= k){
        cout << "YES" << '\n';
        for(int i = 0 ; i < k; i++){
            cout << (i ? 1 : (n - k + 1)) << " \n"[i == k-1];
        }
    }
    else{
        cout << "NO" << '\n';

    }

}



