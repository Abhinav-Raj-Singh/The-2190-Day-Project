void solve(){
    int n ; 
    cin >> n;
    string s;
    cin >> s;
    vector <string> d;
    string a = "" ;
    for(int i = 0 ; i < n ; i++){

        if(s[i] == '#'){
            a.push_back('#');
        }
        else if(s[i] == '*'){
            if(a.find('#') != std::string::npos){
            d.push_back(a);
            a = "";

            }
            a = "";
        }
        if(i == (n-1)){
           
            if(a.find('#') != std::string::npos){
            d.push_back(a);
            a = "";

            }
        }
    }
    // debugva(d);
    sort(d.begin(),d.end());
    if(d.size() == 0){
        cout << 0 << '\n';
        return ;
    }
    int r = d[d.size()-1].size();
    if(r % 2 == 0){
        r = r/2;
    }
    else{
        r = (r/2) + 1;
    }
    cout << ((d.size() == 0 )? 0 : (r)) << '\n';
}



