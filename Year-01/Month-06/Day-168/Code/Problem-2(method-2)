template<typename T> void _print(vector<T> v1){
    cerr << "[ ";
    for(T i : v1){
        
        _print(i);
        cerr << " " ;
    } 
    cerr << " ]" << '\n';
}

template<typename T> void _print(set<T> s1){
    cerr << "[ ";
    for(T i : s1){
        
        _print(i);
        cerr << " " ;
    } 
    cerr << " ]" << '\n';
}

void solve(){
    int n; 
    cin >> n;
    string s; 
    cin >> s;
    int ans = 0 ;
    int cnt = 0;

    for(auto &c : s){
       if(c == '*'){
        cnt = 0;
       } 
       else {
        cnt++;
       }
       ans = max(ans, ((cnt+1)/2));
    }
    cout << ans << '\n' ;
}



