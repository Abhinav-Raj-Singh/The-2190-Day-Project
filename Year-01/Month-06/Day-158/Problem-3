        _print(i);
        cerr << " " ;
    } 
    cerr << " ]" << '\n';
}

void solve(){
    int n , m , l , r ;
    cin >> n >> m >> l >> r;
    int L = 0;
    int R = 0; 
    if(n == m){
        cout << l << " " << r << '\n';
    }
    else{
        for(int i = 1 ; i <= m ;i++){
            if(i % 2 != 0){
                if(L != l){
                    L--;
                }
                else if(R!=r){
                    R++;
                }
            }
            else if(i % 2 ==0){
                if(R != r){
                    R++;
                }
                else if(L != l){
                    L--;
                }
            }
        }
        cout << L << " " << R << '\n';
    }
}



