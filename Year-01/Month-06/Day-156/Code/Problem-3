void solve(){
    string s;
    cin >> s;
    int a = 0 ;
    int b = 0 ;
    for(int i = 0 ; i < s.size() ; i++){
        if(s[i] == 'A'){
            a++;
        }
        else{
            b++;
        }
    }
    cout << ((a>b)? 'A' : 'B') << '\n';
}

