// Problem-1(method-2)
// CSES Weird Algorithm

#include <bits/stdc++.h>
using namespace std;

void solve(){

    long long n;
    cin >> n;
    while(true){
        cout << n << ' ' ;
        if(n==1) break;
        if(n%2 == 0) n = n/2;
        else n = (n*3)+1;
    }
    cout << '\n';

}

int main(){

    ios_base::sync_with_stdio(0);cin.tie(0);

    solve();

    return 0;
}
