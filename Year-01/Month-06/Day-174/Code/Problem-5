void solve(){
    int n,x;
    cin >> n >> x;
    vector <int> d(n);
    for(int i = 0 ; i < n ;i++){
        cin >> d[i];
    }
    int lt = 0;
    bool active = false;
    int cnt = 0;
    for(int i = 0 ; i < n ;i++){
        if(d[i] == 1){

            
            active = true;
            
        }
        else if(d[i] == 0){
            cnt = count(d.begin()+i ,d.end(),1);
            if(cnt == 0 && !active){
            active = false;
                }
        }
        if(active == true){
            lt++;
        }
        
        
        if(d[i] == 1 && lt > x){
                cout << "NO" << '\n';
               
                return;
            }
    }
    cout << "YES" << '\n';
}



