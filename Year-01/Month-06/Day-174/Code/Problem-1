        cerr << " " ;
    } 
    cerr << " ]" << '\n';
}

void solve(){
    int n; 
    cin >> n;
    vector <int> d(n);
    for(int i = 0 ; i < n; i++){
        cin >> d[i];
    }
    int sum = 0 ;
    for(int i = n/2 ; i < n ;i++){
        sum += d[i];
    }
    cout << sum << '\n';
}



