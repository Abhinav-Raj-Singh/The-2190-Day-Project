template<typename T> void _print(set<T> s1){
    cerr << "[ ";
    for(T i : s1){
        
        _print(i);
        cerr << " " ;
    } 
    cerr << " ]" << '\n';
}

void solve(){
    int n ;
    cin >> n;
    vector <int> d(n);
    for(int i = 0 ; i < n ; i++){
        cin >> d[i];
    }
    int answer = 0 ;

    
    while(!d.empty()){
        int a = d.back();
        d.pop_back();

        bool found = false;
        for(int i = 0 ; i < d.size() ; i++){
            if(d[i] == a){
                d.erase(d.begin()+i);
                found = true;
                i--;
                break;
            }
        }
        if(!found){
            answer += a;
        }
    }
    cout << answer << '\n';
}



