void solve(){
    vector <int> a;
    vector <int> b;
    int n ; 
    cin >> n;
    for(int i = 0 ; i < (2*n); i++){
        int r;
        cin >> r;
        if((i+1) % 2 != 0){
            
            a.push_back(r);
        }
        else if((i+1) % 2 == 0){
            b.push_back(r);
        }
    }
    // debugva(a);
    // debugva(b);
    int quality = 0 ; 
    int index = 0;

    for(int i = 0 ; i < (n) ;i++){
        if(a[i] <= 10){
            if(b[i] > quality){
                index = i;
                quality = b[i];
            }
        }
    }
    cout << (index+1) << '\n';
}



