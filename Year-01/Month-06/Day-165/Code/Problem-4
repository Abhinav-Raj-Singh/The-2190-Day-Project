void solve(){
    int cnta = 0;
    int cntb = 0;
    int cntc = 0;
    vector <string> c;
    for(int i = 0 ; i < 3 ; i++){
        string r;
        cin >> r;
        c.push_back(r);
    }

    for(int i = 0 ; i < 3 ;i++){
        for(int j = 0 ; j < 3 ; j++){
            if(c[i][j] == 'A'){
                cnta++;
            }
            else if(c[i][j] == 'B'){
                cntb++;
            }
            else if(c[i][j] == 'C'){
                cntc++;
            }
        }
    }
    if(cnta == 2){
        cout << 'A' << '\n';
    }
    else if(cntb == 2){
        cout << 'B' << '\n';

    }
    else if(cntc == 2){
        cout << 'C' << '\n';

    }
    
}



