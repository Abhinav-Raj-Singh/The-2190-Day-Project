void solve(){
    int n ;
    cin >> n;
    vector <string> a;
    for(int i = 0 ; i < n; i++){
        string b ;
        cin >> b;
        a.push_back(b);
    }
    for(int i = 0 ; i < n ; i++){
        bool has = any_of(a[i].begin(),a[i].end(),[](char c){
            return c == '1';
        });
        if(has){
            if(a[i] == a[i+1]){
                cout << "SQUARE" << '\n';
                return;
            }
            else{
                cout << "TRIANGLE" << '\n';
                return;

            }
        }
    }

}



